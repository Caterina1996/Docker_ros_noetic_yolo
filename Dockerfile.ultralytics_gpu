FROM nvidia/cuda:12.1.0-devel-ubuntu22.04

ARG UID=1000
ARG GID=1000

USER root

# Instala Python 3.11 y utilidades base
RUN apt-get update && apt-get install -y \
    python3.11 python3.11-venv python3.11-distutils \
    python3-pip curl apt-transport-https ca-certificates gnupg lsb-release \
    && rm -rf /var/lib/apt/lists/*

RUN apt-get update && apt-get install -y python3.11 python3.11-venv python3.11-distutils python3-pip curl apt-transport-https ca-certificates gnupg lsb-release libgl1-mesa-glx libglib2.0-0 && rm -rf /var/lib/apt/lists/*

# Alias python y pip a python3.11 y pip3 respectivamente
RUN ln -sf /usr/bin/python3.11 /usr/bin/python && \
    ln -sf /usr/bin/pip3 /usr/bin/pip

# Crear grupo y usuario rosuser con UID/GID pasados como argumento
RUN groupadd -g $GID rosuser && \
    useradd -m -u $UID -g $GID -s /bin/bash rosuser

# Ahora cabia propiedad en el home del usuario, que ya debe existir
RUN chown -R $UID:$GID /home/rosuser

# Instala Docker CLI (opcional, para uso dentro del contenedor)
RUN apt-get update && apt-get install -y \
    apt-transport-https ca-certificates curl gnupg lsb-release && \
    curl -fsSL https://download.docker.com/linux/ubuntu/gpg | gpg --dearmor -o /usr/share/keyrings/docker-archive-keyring.gpg && \
    echo "deb [arch=amd64 signed-by=/usr/share/keyrings/docker-archive-keyring.gpg] https://download.docker.com/linux/ubuntu $(lsb_release -cs) stable" > /etc/apt/sources.list.d/docker.list && \
    apt-get update && apt-get install -y docker-ce-cli && \
    apt-get clean && rm -rf /var/lib/apt/lists/*

# Añadir usuario rosuser al grupo docker
RUN groupadd -g 998 docker || true && \
    usermod -aG docker rosuser || true

# Copiar archivo de requerimientos y luego instalarlos como rosuser
COPY requirements_py311.txt /tmp/requirements_py311_project.txt

USER rosuser
ENV PATH=/home/rosuser/.local/bin:$PATH

RUN pip install --upgrade pip && \
    pip install torch torchvision torchaudio --index-url https://download.pytorch.org/whl/cu121 && \
    pip install ultralytics natsort requests termcolor

CMD ["/bin/bash"]
