# Use the pre-built GPU-enabled Python base image from DockerHub
FROM mikweeh/cv-baseimage-01:latest

# Set build-time arguments for user and group IDs
ARG UID=1000
ARG GID=1000

# Switch to root to make user adjustments
USER root

# Ensure the rosuser has the correct UID/GID (adapting from base image)
RUN if [ $(id -u rosuser) -ne $UID ] || [ $(id -g rosuser) -ne $GID ]; then \
        # Save current user info
        OLD_UID=$(id -u rosuser) && \
        OLD_GID=$(id -g rosuser) && \
        # Change UID/GID
        groupmod -g $GID rosuser 2>/dev/null || true && \
        usermod -u $UID -g $GID rosuser && \
        # Fix ownership of home directory
        find /home/rosuser -user $OLD_UID -exec chown -h $UID {} \; \
             2>/dev/null || true && \
        find /home/rosuser -group $OLD_GID -exec chgrp -h $GID {} \; \
             2>/dev/null || true; \
    fi

# Install Docker CLI for container access
RUN apt-get update && apt-get install -y \
    apt-transport-https \
    ca-certificates \
    curl \
    gnupg \
    lsb-release \
    && curl -fsSL https://download.docker.com/linux/ubuntu/gpg | \
       gpg --dearmor -o /usr/share/keyrings/docker-archive-keyring.gpg \
    && echo "deb [arch=amd64 signed-by=/usr/share/keyrings/docker-archive-keyring.gpg] https://download.docker.com/linux/ubuntu $(lsb_release -cs) stable" > /etc/apt/sources.list.d/docker.list \
    && apt-get update \
    && apt-get install -y docker-ce-cli \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# Create docker group and add user to it
RUN groupadd -g 998 docker || true && \
    usermod -aG docker rosuser || true

# Ensure proper ownership of workspace
RUN chown -R $UID:$GID /home/rosuser

# Copy project-specific requirements
COPY requirements_py311.txt /tmp/requirements_py311_project.txt

# Switch to non-root user
USER rosuser

# Install additional project-specific Python dependencies
RUN if [ -f /tmp/requirements_py311_project.txt ]; then \
        pip install --user -r /tmp/requirements_py311_project.txt; \
    fi

# Default command
CMD ["/bin/bash"]
